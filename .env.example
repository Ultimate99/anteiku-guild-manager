# Browser-safe Supabase values only.
# Copy this file to .env.local for local development.
#
# Production values belong in Vercel Environment Variables, not in committed files.
# Never add service role keys, sb_secret_* keys, database URLs, JWT secrets,
# SMTP secrets, OAuth secrets, or other private credentials here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
